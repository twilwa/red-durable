# Disabled by default. Copy privately outside the checkout; chmod 600.
# No real secrets belong here. Node 24 is required. No OAuth/user self-bot token.
DISCORD_RELAY_ENABLED=false
RED_URL=https://your-worker.example
RED_DISCORD_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_OWNER_ID=
DISCORD_BOT_ID=
DISCORD_SESSION=
RED_DISCORD_DIR=/var/lib/red-discord
# Explicit localhost-only development opt-in; leave false on a real host.
RED_DISCORD_ALLOW_HTTP_LOOPBACK=false
