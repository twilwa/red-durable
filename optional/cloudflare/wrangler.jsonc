{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "red-subscription-cloud-host",
  "main": "controller.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "containers": [{
    "class_name": "SubscriptionHost",
    "image": "./Dockerfile",
    "image_build_context": "../..",
    "instance_type": "lite",
    "max_instances": 1,
    "scheduling_policy": "default",
    "observability": {"enabled": false}
  }],
  "durable_objects": {"bindings": [{"name": "HOST", "class_name": "SubscriptionHost"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["SubscriptionHost"]}],
  "observability": {"enabled": false}
}
